{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/main/editors/vscode/wowluarc.schema.json",
  "flavors": ["forever"],
  "ignore": [
    ".git/**",
    ".vscode/**",
    "tests/**",
    "dist/**",
    "release/**"
  ],
  "diagnostics": {
    "disable": [
      "need-check-nil",
      "redundant-parameter",
      "redundant-or",
      "redundant-and",
      "invalid-op"
    ]
  }
}

