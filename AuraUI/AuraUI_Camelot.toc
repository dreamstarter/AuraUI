# Lightweight addon framework (replaces Ace3)
AuraUI_Lite.lua

# Central multi-language engine (resolves locale + glyph font; defines L/Lf/EnKey)
# Translation data lives in the LoadOnDemand AuraUILocales child addon,
# loaded by the engine at ADDON_LOADED for non-English locales only.
AuraUI_Locale.lua

# Central number-abbreviation engine (K/M/B by default; CJK wan/yi grouping
# tables keyed by locale; a locale file may register its own algorithm).
AuraUI_NumberFormat.lua

# One-time data migration (runs before child addons init)
AuraUI_Migration.lua

